{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dwell.io/mqtt/v1/state-quantity.schema.json",
  "title": "Dwell quantity state",
  "allOf": [
    {
      "$ref": "common-envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "schema": {
          "pattern": "^io\\.dwell\\.state\\.quantity/1\\.\\d+$"
        },
        "body": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
