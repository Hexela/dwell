{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dwell.io/mqtt/v1/availability.schema.json",
  "title": "Dwell availability",
  "allOf": [
    {
      "$ref": "common-envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "schema": {
          "pattern": "^io\\.dwell\\.availability/1\\.\\d+$"
        },
        "body": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "online",
                "degraded",
                "offline",
                "unknown"
              ]
            },
            "since": {
              "$ref": "common-envelope.schema.json#/$defs/timestamp"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
