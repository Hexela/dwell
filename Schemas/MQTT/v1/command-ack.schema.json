{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dwell.io/mqtt/v1/command-ack.schema.json",
  "title": "Dwell command acknowledgement",
  "allOf": [
    {
      "$ref": "common-envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "schema": {
          "pattern": "^io\\.dwell\\.command-ack/1\\.\\d+$"
        },
        "body": {
          "type": "object",
          "required": [
            "commandId",
            "status"
          ],
          "properties": {
            "commandId": {
              "$ref": "common-envelope.schema.json#/$defs/identifier"
            },
            "status": {
              "enum": [
                "accepted",
                "applied",
                "rejected",
                "failed",
                "expired",
                "unknown-outcome"
              ]
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
