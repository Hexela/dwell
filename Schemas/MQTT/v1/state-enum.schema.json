{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dwell.io/mqtt/v1/state-enum.schema.json",
  "title": "Dwell enumeration state",
  "allOf": [
    {
      "$ref": "common-envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "schema": {
          "pattern": "^io\\.dwell\\.state\\.enum/1\\.\\d+$"
        },
        "body": {
          "type": "object",
          "required": [
            "value",
            "allowed"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "allowed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
